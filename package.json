{
  "name": "stackemu-development-tools",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:markdown": "markdownlint-cli2",
    "lint:css": "stylelint src/main/resources/META-INF/resources/app.css",
    "lint:javascript": "eslint .",
    "test:browser": "playwright test",
    "check": "npm run format:check && npm run lint:markdown && npm run lint:css && npm run lint:javascript"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.13.0",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "prettier": "3.6.2",
    "markdownlint-cli2": "0.18.1",
    "stylelint": "16.25.0",
    "stylelint-config-standard": "39.0.1"
  }
}
