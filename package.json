{
  "name": "stackemu-development-tools",
  "private": true,
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:markdown": "markdownlint-cli2",
    "lint:css": "stylelint \"src/main/resources/META-INF/resources/*.css\" src/main/frontend/input.css tools/ux0/input.css",
    "spike:css": "npm --prefix tools/ux0 ci --ignore-scripts --no-audit --no-fund && node tools/ux0/build.mjs",
    "check:contrast": "node --test scripts/check-contrast.test.mjs && node scripts/check-contrast.mjs",
    "check:docs": "node --test scripts/check-docs.test.mjs && node scripts/check-docs.mjs",
    "lint:javascript": "eslint .",
    "test:browser": "playwright test",
    "check": "npm run format:check && npm run lint:markdown && npm run check:docs && npm run lint:css && npm run lint:javascript && npm run check:contrast"
  },
  "devDependencies": {
    "tailwindcss": "4.3.3",
    "@tailwindcss/cli": "4.3.3",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.13.0",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "prettier": "3.6.2",
    "markdownlint-cli2": "0.18.1",
    "stylelint": "16.25.0",
    "stylelint-config-standard": "39.0.1"
  }
}
